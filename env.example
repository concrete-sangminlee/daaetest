# Slack Incoming Webhook URL (필수 - 실제 URL로 교체)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ"

# Slack에 표시될 요약 헤더 커스터마이즈(선택)
# 권장: Slack 기본 이모지 코드(:newspaper:) 또는 유니코드(📰)를 사용하세요.
# ":신문:"처럼 한국어 shortcode는 Slack 기본으로는 렌더링되지 않으며,
# 필요하면 Slack에 커스텀 이모지(이름: 신문)를 직접 추가해야 합니다.
ALERT_EMOJI="📰"
# 예) "협동과정 인공지능 전공", "건축학과" 등
ALERT_FEED_NAME="건축학과"

# 감시할 사이트(기본: https://architecture.snu.ac.kr)
# 새 SPA 사이트의 공지 API(POST /rest/activities/getNotices)를 호출합니다.
# (구버전 변수명 WP_BASE_URL도 하위호환으로 인식됩니다.)
BASE_URL="https://architecture.snu.ac.kr"

# 한 번의 실행에서 Slack으로 보낼 최대 글 수 (초과 시 가장 최근 것 위주로 일부만 전송)
MAX_NOTIFY_PER_RUN=20

# 최초 실행 시(상태 파일이 없을 때) 기존 글을 전송할지 여부
# - false(기본): 최신 글을 '기준점'으로 저장만 하고 전송 안 함(스팸 방지)
# - true: 초기에도 최근 글들을 전송함(주의)
SEND_ON_FIRST_RUN=false

# 상태 저장 파일 경로
STATE_PATH="./state.json"

# Slack 메시지 옵션(선택)
# SLACK_CHANNEL="#your-channel"
# SLACK_USERNAME="daae-slack-bot"

# Notion API 설정(선택 - 설정하면 Notion 페이지에도 새 글이 추가됩니다)
# 1. https://www.notion.so/my-integrations 에서 Integration 생성
# 2. 생성된 Integration의 "Internal Integration Token"을 NOTION_TOKEN에 설정
# 3. 대상 Notion 페이지에서 "연결 추가"로 해당 Integration을 연결
# 4. 페이지 URL에서 페이지 ID 추출 (예: https://www.notion.so/Notice-27e2cbf5657380319715fa24fb5d4d15)
#    -> 페이지 ID: 27e2cbf5657380319715fa24fb5d4d15 (하이픈 제거한 형태 또는 URL 전체)
# NOTION_TOKEN="secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# NOTION_PAGE_ID="27e2cbf5657380319715fa24fb5d4d15"
# 또는 URL 전체:
# NOTION_PAGE_ID="https://www.notion.so/Notice-27e2cbf5657380319715fa24fb5d4d15"


