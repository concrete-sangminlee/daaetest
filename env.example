# Slack Incoming Webhook URL (필수 - 실제 URL로 교체)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ"

# Slack에 표시될 요약 헤더 커스터마이즈(선택)
# 권장: Slack 기본 이모지 코드(:newspaper:) 또는 유니코드(📰)를 사용하세요.
# ":신문:"처럼 한국어 shortcode는 Slack 기본으로는 렌더링되지 않으며,
# 필요하면 Slack에 커스텀 이모지(이름: 신문)를 직접 추가해야 합니다.
ALERT_EMOJI="📰"
# 예) "협동과정 인공지능 전공", "건축학과" 등
ALERT_FEED_NAME="건축학과"

# 감시할 WordPress 사이트(기본: https://architecture.snu.ac.kr)
WP_BASE_URL="https://architecture.snu.ac.kr"

# true로 설정하면 카테고리 필터 없이 전체 글을 감시합니다.
# WP_WATCH_ALL=true

# 알림 대상 카테고리 (둘 중 하나 또는 둘 다 사용 가능)
# - slug 기반(추천): notice, pinup 등
WP_CATEGORY_SLUGS="notice"
# - id 기반: 20,33 등
# WP_CATEGORY_IDS="20"

# 한 번에 조회할 최신 글 수 (크게 잡을수록 누락 위험이 줄지만 요청/응답이 커짐)
WP_PER_PAGE=30

# 한 번의 실행에서 Slack으로 보낼 최대 글 수 (초과 시 오래된 것부터 일부만 전송)
MAX_NOTIFY_PER_RUN=20

# 최초 실행 시(상태 파일이 없을 때) 기존 글을 전송할지 여부
# - false(기본): 최신 글을 '기준점'으로 저장만 하고 전송 안 함(스팸 방지)
# - true: 초기에도 최근 글들을 전송함(주의)
SEND_ON_FIRST_RUN=false

# 상태 저장 파일 경로
STATE_PATH="./state.json"

# Slack 메시지 옵션(선택)
# SLACK_CHANNEL="#your-channel"
# SLACK_USERNAME="daae-slack-bot"


